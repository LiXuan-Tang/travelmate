rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in user can read profiles; only owner can write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Trips: owner and collaborators can read; only owner can write
    match /trips/{tripId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         request.auth.uid in resource.data.collaborators ||
         resource.data.visibility == 'public');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;

      // Destinations subcollection: any authenticated user with trip access
      match /destinations/{destId} {
        allow read, write: if request.auth != null;
      }
    }

    // Community posts: public posts readable by all signed-in users
    match /posts/{postId} {
      allow read: if request.auth != null &&
        (resource.data.visibility == 'public' ||
         resource.data.authorId == request.auth.uid);
      allow create: if request.auth != null;
      // Authors can update everything; any signed-in user can update likesCount
      // (e.g. when liking/unliking a post)
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
      );
      allow delete: if request.auth != null &&
        resource.data.authorId == request.auth.uid;

      // Comments subcollection: any signed-in user can read/create; only author can delete
      match /comments/{commentId} {
        allow read, create: if request.auth != null;
        allow delete: if request.auth != null &&
          resource.data.authorId == request.auth.uid;
      }
    }

    // Top-level comments collection (legacy — kept for safety)
    match /comments/{commentId} {
      allow read, create: if request.auth != null;
      allow delete: if request.auth != null &&
        resource.data.authorId == request.auth.uid;
    }

    // Likes, saved posts, notifications, reports: signed-in only
    match /likes/{likeId} {
      allow read, write: if request.auth != null;
    }
    match /savedPosts/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }
    match /reports/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
